{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)image/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG CLAUDE_CODE_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["@anthropic-ai/claude-code"],
      "description": "Bumping the ARG default touches image/**, which the publish workflow rebuilds + republishes :stable. Security harness still gates the publish.",
      "commitMessageTopic": "Claude Code"
    }
  ]
}
