#!/usr/bin/env bash
# cc-sandbox — launch Claude Code (--dangerously-skip-permissions) inside the Sandbox.
#
# This script is co-load-bearing with the image: it applies the EXTERNAL run policy the image
# cannot set itself (cap-drop, mounts, network, --rm, ports) and does the surgical OAuth extraction.
# It is intentionally small and readable — audit it. See CONTEXT.md and docs/adr/.
#
# Usage:  cd <project> && cc-sandbox [--resume] [--fresh] [--ephemeral] [--port N]... [--no-config] [--unsafe] [-- <claude args>]
#   --resume     pick one of this project's past sessions to resume (native Claude picker)
#   --fresh      wipe this project's cached deps and saved sessions first
#   --ephemeral  no on-disk session state (not resumable)
#   --port N     also forward an extra dev-server port (repeatable)
#   --no-config  pristine box: do NOT bring your host skills / global CLAUDE.md / rules
#   --update     update the Wrapper + pull the latest image, then exit
#   --export-session   copy this project's sandbox sessions to the host so `claude --resume`
#                      (outside the sandbox) can continue them, then exit
#   --unsafe     ESCAPE HATCH: plain `claude --dangerously-skip-permissions`, NO sandbox
set -euo pipefail

# ----------------------------------------------------------------------------- config
IMAGE="${CC_SANDBOX_IMAGE:-ghcr.io/mhensberg2003/claude-code-sandbox/cc-sandbox:stable}"
MEMORY="${CC_SANDBOX_MEMORY:-8g}"
PIDS_LIMIT="${CC_SANDBOX_PIDS:-512}"
# Dev-server ports auto-forwarded to 127.0.0.1 on the Host (inbound-from-localhost is not exfil).
COMMON_PORTS=(3000 3001 4200 5000 5173 5174 8000 8080 8081 9000)
# Minimal caps the root entrypoint needs (firewall, uid-switch, setup chowns/ACLs). The agent runs
# as non-root `claude` with NO ambient caps, so it cannot use any of these directly.
CAPS=(NET_ADMIN SETUID SETGID CHOWN DAC_OVERRIDE FOWNER FSETID SETPCAP AUDIT_WRITE)

# ----------------------------------------------------------------------------- helpers
die()  { echo "cc-sandbox: $*" >&2; exit 1; }
warn() { echo "cc-sandbox: $*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }
hash_id() { printf '%s' "$1" | { have sha256sum && sha256sum || shasum -a 256; } | cut -c1-12; }

# ----------------------------------------------------------------------------- arg parsing
RESUME=0; FRESH=0; UNSAFE=0; EPHEMERAL=0; UPDATE=0; EXPORT=0; NO_CONFIG=0; EXTRA_PORTS=(); CLAUDE_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --resume|--continue) RESUME=1 ;;
        --fresh)             FRESH=1 ;;
        --ephemeral)         EPHEMERAL=1 ;;
        --no-config)         NO_CONFIG=1 ;;
        --update)            UPDATE=1 ;;
        --export-session)    EXPORT=1 ;;
        --unsafe)            UNSAFE=1 ;;
        --port)              shift; [[ "${1:-}" =~ ^[0-9]+$ ]] || die "--port needs a number"; EXTRA_PORTS+=("$1") ;;
        --help|-h)           sed -n '2,18p' "$0"; exit 0 ;;
        --)                  shift; CLAUDE_ARGS+=("$@"); break ;;
        *)                   CLAUDE_ARGS+=("$1") ;;
    esac
    shift || true
done

# ----------------------------------------------------------------------------- self-update
if [[ "$UPDATE" == 1 ]]; then
    REPO="${CC_SANDBOX_REPO:-mhensberg2003/claude-code-sandbox}"
    REF="${CC_SANDBOX_REF:-main}"
    SELF="$(command -v cc-sandbox 2>/dev/null || true)"; [[ -n "$SELF" ]] || SELF="$0"
    [[ -w "$SELF" ]] || die "cannot write $SELF (no permission). Re-run the installer manually."
    url="https://raw.githubusercontent.com/${REPO}/${REF}/bin/cc-sandbox"
    tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
    echo "cc-sandbox: updating Wrapper from $url"
    if curl -fsSL "$url" -o "$tmp" && [[ -s "$tmp" ]] && head -1 "$tmp" | grep -q '^#!'; then
        cat "$tmp" > "$SELF"; echo "  Wrapper updated -> $SELF"
    else
        die "failed to download an updated Wrapper (check network / repo)."
    fi
    if have docker && docker info >/dev/null 2>&1 && [[ "$IMAGE" == */* ]]; then
        echo "cc-sandbox: pulling latest image (~1.8GB first time; shows progress below)"
        docker pull "$IMAGE" && echo "  image up to date" || warn "image pull failed"
    fi
    echo "cc-sandbox: done."
    exit 0
fi

# ----------------------------------------------------------------------------- escape hatch
if [[ "$UNSAFE" == 1 ]]; then
    warn "############################################################"
    warn "# --unsafe: running Claude Code with NO sandbox on the HOST #"
    warn "# Commands have full network + filesystem access.           #"
    warn "############################################################"
    have claude || die "claude not found on PATH for --unsafe mode"
    exec claude --dangerously-skip-permissions "${CLAUDE_ARGS[@]}"
fi

# ----------------------------------------------------------------------------- preflight
have docker || die "Docker is required but not found. Install Docker and retry."
docker info >/dev/null 2>&1 || die "Docker is installed but not running. Start Docker and retry."

PROJECT="$PWD"
[[ -d "$PROJECT" ]] || die "current directory is not accessible"
case "$PROJECT" in /|"$HOME") die "refusing to sandbox '$PROJECT' — cd into a project directory first" ;; esac

# ----------------------------------------------------------------------------- export sessions to host
if [[ "$EXPORT" == 1 ]]; then
    vol="cc-session-$(hash_id "$PROJECT")"
    docker volume inspect "$vol" >/dev/null 2>&1 || die "no saved sandbox sessions for this project"
    slug="$(printf '%s' "$PROJECT" | sed 's#/#-#g')"
    dest="$HOME/.claude/projects/$slug"
    mkdir -p "$dest"
    # Copy transcripts out of the volume, rewriting the in-box path to the real host path so
    # `claude --resume` on the host keys and resolves them correctly. Runs as the host user so
    # the exported files are owned by you, not root.
    n="$(docker run --rm --user "$(id -u):$(id -g)" -v "$vol:/v:ro" -v "$dest:/out" \
            -e DST="$PROJECT" alpine sh -c '
              c=0
              for f in /v/.claude/projects/-workspace-project/*.jsonl; do
                [ -e "$f" ] || continue
                sed "s#/workspace/project#${DST}#g" "$f" > "/out/$(basename "$f")" && c=$((c+1))
              done
              printf %s "$c"')"
    [[ "${n:-0}" -gt 0 ]] || die "no session transcripts found in the volume"
    echo "cc-sandbox: exported $n session(s) -> $dest"
    echo "  NOTE: resuming on the host runs WITHOUT the sandbox (full host access)."
    echo "  Continue with:  cd \"$PROJECT\" && claude --resume"
    exit 0
fi

# ----------------------------------------------------------------------------- OAuth extraction
# Extract ONLY claudeAiOauth (never mcpOAuth or anything else) into a private temp file.
SECRET_DIR="$(mktemp -d "${TMPDIR:-/tmp}/cc-sandbox.XXXXXX")"
chmod 700 "$SECRET_DIR"
cleanup() { rm -rf "$SECRET_DIR"; }
trap cleanup EXIT INT TERM

extract_oauth() {
    local raw=""
    if [[ "$(uname -s)" == "Darwin" ]]; then
        raw="$(security find-generic-password -s 'Claude Code-credentials' -w 2>/dev/null || true)"
    elif [[ -f "$HOME/.claude/.credentials.json" ]]; then
        raw="$(cat "$HOME/.claude/.credentials.json")"
    fi
    [[ -n "$raw" ]] || return 1
    # Emit {"claudeAiOauth": <object>} and nothing else.
    if have jq; then
        printf '%s' "$raw" | jq -e '{claudeAiOauth: .claudeAiOauth}' 2>/dev/null
    elif have python3; then
        printf '%s' "$raw" | python3 -c \
          'import sys,json; d=json.load(sys.stdin); o=d.get("claudeAiOauth");
import sys as s; sys.exit(1) if o is None else print(json.dumps({"claudeAiOauth":o}))' 2>/dev/null
    else
        return 2
    fi
}

if out="$(extract_oauth)"; then
    printf '%s' "$out" > "$SECRET_DIR/credentials.json"
    chmod 600 "$SECRET_DIR/credentials.json"
else
    warn "could not extract Claude OAuth token — run 'claude login' on the host first."
    warn "(continuing; Claude Code will prompt for auth inside the box)"
fi

# Minimal onboarding/account markers so Claude knows login is already done. NOT the whole
# ~/.claude.json (which holds project history, MCP configs, etc.) — just these identity fields.
extract_config_markers() {
    local keys='("userID","hasCompletedOnboarding","lastOnboardingVersion","oauthAccount")'
    [[ -f "$HOME/.claude.json" ]] || return 1
    if have jq; then
        jq '{userID, hasCompletedOnboarding, lastOnboardingVersion, oauthAccount}' "$HOME/.claude.json" 2>/dev/null
    elif have python3; then
        python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(json.dumps({k:d.get(k) for k in $keys}))" "$HOME/.claude.json" 2>/dev/null
    fi
}
if cfg="$(extract_config_markers)" && [[ -n "$cfg" ]]; then
    printf '%s' "$cfg" > "$SECRET_DIR/claude-config.json"
    chmod 600 "$SECRET_DIR/claude-config.json"
fi

# ----------------------------------------------------------------------------- user skills + global config
# Stage the user's OWN skills and global CLAUDE.md / rules so they carry into the box. These are
# authored content (not secrets), and skill scripts run INSIDE the sandbox — the safe place for them.
# Copied (never bind-mounted) with `cp -L` so symlinked skills (e.g. ~/.agents/skills/*) are
# dereferenced and never dangle in-box. Skip entirely with --no-config or CC_SANDBOX_NO_CONFIG=1.
stage_user_config() {
    local stage="$SECRET_DIR/user-claude" staged=0
    mkdir -p "$stage"
    [[ -d "$HOME/.claude/skills" ]] && cp -rL "$HOME/.claude/skills" "$stage/skills"     2>/dev/null && staged=1
    [[ -f "$HOME/.claude/CLAUDE.md" ]] && cp -L "$HOME/.claude/CLAUDE.md" "$stage/CLAUDE.md" 2>/dev/null && staged=1
    [[ -d "$HOME/.claude/rules"  ]] && cp -rL "$HOME/.claude/rules"  "$stage/rules"      2>/dev/null && staged=1
    [[ "$staged" == 1 ]] && chmod -R u+rwX "$stage" || rmdir "$stage" 2>/dev/null || true
}
if [[ "$NO_CONFIG" == 0 && -z "${CC_SANDBOX_NO_CONFIG:-}" ]]; then
    stage_user_config
fi

# ----------------------------------------------------------------------------- git identity (name/email only)
GIT_NAME="$(git config --get user.name  2>/dev/null || true)"
GIT_EMAIL="$(git config --get user.email 2>/dev/null || true)"

# ----------------------------------------------------------------------------- per-project volumes
PID_HASH="$(hash_id "$PROJECT")"
CACHE_VOL="cc-cache-${PID_HASH}"
SESSION_VOL="cc-session-${PID_HASH}"

if [[ "$FRESH" == 1 ]]; then
    docker volume rm -f "$CACHE_VOL" "$SESSION_VOL" >/dev/null 2>&1 || true
    warn "fresh: wiped caches for this project"
fi

# ----------------------------------------------------------------------------- assemble docker run
ARGS=(run --rm --hostname cc-sandbox)
# Interactive TTY only when we actually have one (so `-p`/piped use still works).
[[ -t 0 && -t 1 ]] && ARGS+=(-it)
# Auto-update the policy image only for registry refs; local/dev tags are used as-is.
[[ "$IMAGE" == */* ]] && ARGS+=(--pull=always)
ARGS+=(
      --cap-drop=ALL
      --pids-limit "$PIDS_LIMIT"
      --memory "$MEMORY"
      --security-opt label=disable
      -e "HOST_UID=$(id -u)" -e "HOST_GID=$(id -g)"
      -e "GIT_AUTHOR_NAME=${GIT_NAME}" -e "GIT_AUTHOR_EMAIL=${GIT_EMAIL}"
      -v "${PROJECT}:/workspace/project"
      -v "${CACHE_VOL}:/home/runner"
      -w /workspace/project)

for c in "${CAPS[@]}";  do ARGS+=(--cap-add "$c"); done

# Read-only rootfs + writable tmpfs/volumes (toggle off with CC_SANDBOX_WRITABLE_ROOT=1 to debug).
if [[ -z "${CC_SANDBOX_WRITABLE_ROOT:-}" ]]; then
    ARGS+=(--read-only --tmpfs /tmp --tmpfs /run --tmpfs /var/tmp)
fi

# Session home. Persisted per-project by default so `--resume` can continue your last
# conversation (transcripts live in a LOCAL docker volume; wipe with --fresh). Use --ephemeral
# for zero on-disk session state (tmpfs), at the cost of never being resumable.
if [[ "$EPHEMERAL" == 1 ]]; then
    ARGS+=(--tmpfs /home/claude:exec,mode=0700)
else
    ARGS+=(-v "${SESSION_VOL}:/home/claude")
    # Native session picker: lists this project's past sessions to choose from.
    [[ "$RESUME" == 1 ]] && CLAUDE_ARGS=(--resume "${CLAUDE_ARGS[@]}")
fi

# OAuth token + onboarding markers (read-only); entrypoint copies them into the ephemeral home.
[[ -f "$SECRET_DIR/credentials.json" ]] && \
    ARGS+=(-v "${SECRET_DIR}/credentials.json:/run/cc-secret/credentials.json:ro")
[[ -f "$SECRET_DIR/claude-config.json" ]] && \
    ARGS+=(-v "${SECRET_DIR}/claude-config.json:/run/cc-secret/claude-config.json:ro")

# User-authored skills + global CLAUDE.md/rules (read-only); entrypoint copies them into claude's home.
[[ -d "$SECRET_DIR/user-claude" ]] && \
    ARGS+=(-v "${SECRET_DIR}/user-claude:/run/cc-secret/user-claude:ro")

# Port forwarding, bound to localhost only.
for p in "${COMMON_PORTS[@]}" "${EXTRA_PORTS[@]}"; do ARGS+=(-p "127.0.0.1:${p}:${p}"); done

ARGS+=("$IMAGE" "${CLAUDE_ARGS[@]}")

exec docker "${ARGS[@]}"
